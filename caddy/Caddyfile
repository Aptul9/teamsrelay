# TeamsRelay: Caddy with automatic HTTPS. DOMAIN and HTTPS_PORT come from .env through docker-compose.yml.
{
	http_port 80
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN} {
	# Remote desktop of the browsers container on /desktop/: the browser window of every Teams account.
	# Caddy asks the web app whether the session cookie belongs to a user with an account before letting a
	# request through.
	redir /desktop /desktop/ 302
	# desktop of one account, the address of the releases with one desktop per account
	@deskslot path_regexp deskslot ^/desktop/([0-9]+)/?$
	redir @deskslot /api/desktop/{re.deskslot.1} 302
	handle /desktop/* {
		forward_auth webapp:8090 {
			uri /api/authcheck
			# the check is a plain HTTP request even when the original one is a websocket (the desktop
			# stream): with Upgrade the web app would answer 403
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy browsers:3000
	}
	handle {
		reverse_proxy webapp:8090
	}
}

# Photo reader of upper-manager (its own compose project, container upper-manager-ocr on this network).
# OCR_DOMAIN comes from .env through docker-compose.yml; its default http://ocr.localhost answers nothing real
# and asks for no certificate, so the local stack and CI load this block unchanged.
{$OCR_DOMAIN} {
	# the reader caps its own body below this: Caddy must not answer 413 before the reader can explain
	request_body {
		max_size 50MB
	}
	reverse_proxy upper-manager-ocr:8080
}
