# TeamsRelay — Caddy con HTTPS automatico.
# DOMAIN, DESKTOP_DOMAIN e HTTPS_PORT arrivano da .env tramite docker-compose.yml.
{
	http_port 80
	https_port {$HTTPS_PORT:443}
}

{$DOMAIN} {
	# Desktop remoto (Teams nel Chromium del server) sullo stesso dominio, protetto dal login di TeamsRelay:
	# Caddy chiede a /api/authcheck se il cookie di sessione è valido prima di far passare la richiesta.
	redir /desktop /desktop/
	handle /desktop/* {
		forward_auth webapp:8090 {
			uri /api/authcheck
		}
		reverse_proxy chromium:3000
	}
	handle {
		reverse_proxy webapp:8090
	}
}

# ---- Opzionale: desktop remoto su un sottodominio ----
# Protetto dalle credenziali DESKTOP_USER / DESKTOP_PASS del container chromium.
# 1) record DNS per DESKTOP_DOMAIN   2) imposta DESKTOP_DOMAIN e DESKTOP_URL in .env
# 3) togli il commento al blocco qui sotto   4) docker compose up -d caddy
#
# {$DESKTOP_DOMAIN} {
# 	reverse_proxy chromium:3000
# }
