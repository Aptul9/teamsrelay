# TeamsRelay — Caddy con HTTPS automatico.
# DOMAIN e HTTPS_PORT arrivano da .env tramite docker-compose.yml.
{
	http_port 80
	https_port {$HTTPS_PORT:443}
}

# Desktop remoto dello slot N (il Chromium con Teams di quell'account) su /desktop/N/, protetto dal login
# di TeamsRelay: Caddy chiede a /api/authcheck se il cookie di sessione è valido prima di far passare la richiesta.
# Se lo slot è spento il container non esiste in rete e la risposta è 502.
(desktop) {
	redir /desktop/{args[0]} /desktop/{args[0]}/
	handle /desktop/{args[0]}/* {
		forward_auth webapp:8090 {
			uri /api/authcheck
			# la verifica è una richiesta HTTP normale anche quando quella originale è un websocket
			# (lo stream del desktop): con Upgrade la web app risponderebbe 403
			header_up -Upgrade
			header_up -Connection
		}
		reverse_proxy chromium-{args[0]}:3000
	}
}

{$DOMAIN} {
	import desktop 1
	import desktop 2
	import desktop 3
	import desktop 4
	# vecchio indirizzo del desktop, prima degli account: si torna all'app
	redir /desktop / 302
	redir /desktop/ / 302
	handle {
		reverse_proxy webapp:8090
	}
}
