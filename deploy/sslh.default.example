# TeamsRelay — esempio di /etc/default/sslh per condividere la porta 443 fra HTTPS e OpenVPN.
# Richiede nel .env:  HTTPS_PORT=8443  e  HTTPS_BIND=127.0.0.1   (Caddy ascolta solo in locale)
# e OpenVPN in ascolto TCP su 127.0.0.1:1443.
DAEMON=/usr/sbin/sslh
DAEMON_OPTS="--user sslh --listen 0.0.0.0:443 --openvpn 127.0.0.1:1443 --tls 127.0.0.1:8443"
RUN=yes
