[Unit]
Description=TeamsRelay - tunnel Cloudflare per il desktop remoto
After=network-online.target docker.service
Wants=network-online.target

[Service]
Environment=TR_DIR=/opt/teamsrelay
ExecStart=/opt/teamsrelay/deploy/desktop-tunnel.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
