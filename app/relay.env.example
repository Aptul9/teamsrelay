# TeamsRelay local relay (npm run relay). Every variable is optional: the values below are the defaults.
# npm run relay:setup copies this file to relay.env (never in git).

# Browser profile, database, images, push keys, API token (never in git, back it up encrypted)
STATE_DIR=state
# Installed browser the relay drives on its own profile: chrome or msedge
BROWSER_CHANNEL=chrome
TEAMS_URL=https://teams.cloud.microsoft/

# API and app for the phone. Loopback: nothing outside this machine reaches it. See docs/setup.md, Local relay.
RELAY_BIND=127.0.0.1
RELAY_PORT=8787
# HTTPS on the API itself (PEM files), only when no proxy in front terminates TLS
RELAY_TLS_CERT=
RELAY_TLS_KEY=

# Contact the push services may use about this sender: a mailto: or https:// URL of yours
VAPID_SUBJECT=mailto:admin@example.com
# Optional second channel: ntfy topic (keep it unguessable, anyone who knows it reads the messages)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Name of this machine in the alerts; default: the host name
HOST_LABEL=

# A TeamsRelay server to join, as an account on another computer: "Add from another computer" in its account menu
# shows both lines. Joined, the account shows in the web app of the server, which sends its notifications.
# https:// (http:// only for a server on this machine)
SERVER_URL=
SERVER_TOKEN=

# Fleet remote management (optional). With FLEET_VM and FLEET_PORT set, ecosystem.config.cjs also starts cmdapi and a
# reverse SSH tunnel that publishes cmdapi on the hub VM's loopback, so the host can be updated remotely with no inbound
# connection and no sshd here. docs/design/2026-10-01-fleet-remote-management.md.
# Hub VM ssh alias (an entry in this user's ~/.ssh/config). Empty = fleet off.
FLEET_VM=
# Port on the VM's loopback this host's cmdapi is published on. Unique per host.
FLEET_PORT=
# cmdapi: a command runner on loopback, reached only through the tunnel. Off-loopback REQUIRES a token or it refuses to
# start. The token is checked on /command: generate one with
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
CMDAPI_HOST=127.0.0.1
CMDAPI_PORT=8765
CMDAPI_TOKEN=
# Seconds before a command is killed with its whole tree (an update runs npm ci, so keep it generous).
CMDAPI_TIMEOUT=600
# Byte cap per stream (stdout, stderr); output past it is dropped and flagged.
CMDAPI_MAX_OUTPUT=1000000
# Default working directory for commands. Empty = the server's own cwd; app/ suits remote updates.
CMDAPI_CWD=
# Shell for string commands. Empty = the default: PowerShell on Windows, /bin/sh on POSIX.
CMDAPI_SHELL=
