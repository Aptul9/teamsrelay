# TeamsRelay local relay (npm run relay). Every variable is optional: the values below are the defaults.
# npm run relay:setup copies this file to relay.env (never in git).

# Browser profile, database, images, push keys, API token (never in git, back it up encrypted)
STATE_DIR=state
# Installed browser the relay drives on its own profile: chrome or msedge
BROWSER_CHANNEL=chrome
TEAMS_URL=https://teams.cloud.microsoft/

# API and app for the phone. Loopback: nothing outside this machine reaches it. See docs/setup.md, Local relay.
RELAY_BIND=127.0.0.1
RELAY_PORT=8787
# Run a second relay on this machine: INSTANCE shifts RELAY_PORT by N (1 -> 8788) and, unless STATE_DIR is set, keeps
# its own state under state-N. One number instead of a hand-picked port and directory. 0 (the default) is RELAY_PORT
# and STATE_DIR untouched.
INSTANCE=0
# HTTPS on the API itself (PEM files), only when no proxy in front terminates TLS
RELAY_TLS_CERT=
RELAY_TLS_KEY=

# Contact the push services may use about this sender: a mailto: or https:// URL of yours
VAPID_SUBJECT=mailto:admin@example.com
# Optional second channel: ntfy topic (keep it unguessable, anyone who knows it reads the messages)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Name of this machine in the alerts; default: the host name
HOST_LABEL=

# A TeamsRelay server to join, as an account on another computer: "Add from another computer" in its account menu
# shows both lines. Joined, the account shows in the web app of the server, which sends its notifications.
# https:// (http:// only for a server on this machine)
SERVER_URL=
SERVER_TOKEN=

# A browser of its own on this computer for the AI clients (MCP) of the owner, driven through the server joined:
# 1 to turn it on. Own window and profile (state/ai-profile), never the Teams window; closes after RELAY_BROWSER_IDLE
# seconds without use. Whoever holds an OAuth token of the owner can browse from this computer: see docs/security.md.
RELAY_BROWSER=0
RELAY_BROWSER_IDLE=900

# Fleet remote management (optional). The fleet agent is a separate process from the relay; it runs the components you
# enable in fleet.config.json (cmdapi, ssh). This one flag only decides whether pm2 starts that agent here; set it to
# any value to run it under `npx pm2 start ecosystem.config.cjs`, or start it standalone with `npm run fleet:agent`.
# Empty = no fleet agent. Components, ports, token and ssh keys live in fleet.config.json (see fleet.config.example.json),
# never here. docs/design/2026-10-01-fleet-remote-management.md.
FLEET_AGENT=
