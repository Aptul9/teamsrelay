{
  "name": "teamsrelay-webapp",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8090",
    "build": "next build && npm run build:agent && npm run build:supervisor",
    "start": "next start -p 8090",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:agent": "esbuild src/agent/main.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --external:playwright-core --external:better-sqlite3 --outfile=dist/agent.cjs --log-level=warning",
    "build:supervisor": "esbuild src/supervisor/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/supervisor.cjs --log-level=warning",
    "agent": "node --enable-source-maps dist/agent.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dompurify": "3.4.16",
    "geist": "1.7.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "playwright-core": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
