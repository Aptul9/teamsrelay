{
  "name": "teamsrelay-webapp",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8090",
    "build": "next build && npm run build:agent && npm run build:supervisor && npm run build:relay && npm run build:hub",
    "start": "next start -p 8090",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:agent": "esbuild src/agent/main.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --external:playwright-core --external:better-sqlite3 --outfile=dist/agent.cjs --log-level=warning",
    "build:supervisor": "esbuild src/supervisor/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/supervisor.cjs --log-level=warning",
    "build:relay": "esbuild src/local/main.ts --bundle --platform=node --target=node24 --format=cjs --external:playwright-core --external:better-sqlite3 --external:@playwright/mcp --outfile=dist/relay.cjs --log-level=warning",
    "build:hub": "esbuild src/server/call-audio-preload.ts --bundle --platform=node --target=node24 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=dist/call-audio.cjs --log-level=warning",
    "agent": "node --enable-source-maps dist/agent.cjs",
    "relay": "node dist/relay.cjs",
    "relay:login": "node dist/relay.cjs login",
    "relay:setup": "node scripts/relay-setup.mjs"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.7",
    "@modelcontextprotocol/server": "2.1.0",
    "@playwright/mcp": "0.0.83",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dompurify": "3.4.16",
    "geist": "1.7.2",
    "google-auth-library": "11.1.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "playwright-core": "1.63.0",
    "pm2": "7.0.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "undici": "7.30.0",
    "web-push": "3.6.7",
    "ws": "8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
