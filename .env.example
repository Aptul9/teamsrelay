# TeamsRelay configuration. Copy to .env and fill in:   cp .env.example .env
# .env holds secrets: never commit it (it is in .gitignore). Reference: docs/configuration.md

# Public name of the server; its DNS record points to the server and Caddy gets the certificate for it
DOMAIN=teams.example.com

# Key that signs the web app sessions, at least 32 characters:   openssl rand -hex 32
# Changing it signs every user out.
BETTER_AUTH_SECRET=

# First administrator, created at the first start while the server has no users
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MCP endpoint /mcp for AI clients (Claude Code, opencode...), read only, acting as ADMIN_EMAIL.
# Empty: off. Otherwise at least 32 characters:   openssl rand -hex 32
MCP_TOKEN=

# Teams accounts of the server, each one a browser with its agent in the browsers container.
# ACCOUNTS_PER_USER empty means no cap: the memory of the server is the only limit.
ACCOUNTS_PER_USER=

# Remote desktop: keep DESKTOP_PASS empty, it is behind the web app login (users with a Teams account only).
DESKTOP_USER=
DESKTOP_PASS=
# Address of the desktop of account {n}. Empty: /api/desktop/{n} on DOMAIN, which brings the window of the
# account to the front of the one desktop, /desktop/.
DESKTOP_URL=

# Contact required by the Web Push standard (VAPID)
VAPID_SUBJECT=mailto:admin@example.com

# Time zone of the automatic checks (8-11 and 17-20)
TZ=Europe/Rome

# HTTPS port and bind address of Caddy
HTTPS_PORT=443
HTTPS_BIND=0.0.0.0

# Optional: notifications through ntfy as well
NTFY_ENABLED=0
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
