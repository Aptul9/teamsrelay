# ==================== TeamsRelay — configurazione ====================
# Copia questo file in .env e compila i valori:   cp .env.example .env
# .env contiene password: NON committarlo (e' gia' in .gitignore).

# --- Dominio pubblico della web app (record DNS A -> IP del server) ---
DOMAIN=teams.example.com

# --- Accesso alla web app (credenziali robuste: proteggono anche il desktop remoto, cioè la sessione Teams) ---
UI_USER=
UI_PASS=
# Chiave che firma il cookie di sessione (valido 1 anno). Genera con:  openssl rand -hex 32
# Se vuota viene derivata da UI_USER/UI_PASS. Cambiarla disconnette tutti i dispositivi.
SESSION_SECRET=

# --- Desktop remoto (interfaccia web del Chromium che ospita Teams) ---
# Pubblicato su https://<DOMAIN>/desktop/ dietro il login della web app (UI_USER/UI_PASS):
# lascia vuota DESKTOP_PASS, altrimenti il Chromium chiede una seconda password.
# Serve solo con il tunnel Cloudflare o con il sottodominio, che saltano il login dell'app.
DESKTOP_USER=
DESKTOP_PASS=
# Indirizzo del desktop per l'app. Vuoto = /desktop/ sullo stesso dominio.
# Con il tunnel Cloudflare l'URL viene scritto da solo in data/desktop_url.txt.
DESKTOP_URL=
# Sottodominio del desktop per Caddy (solo se attivi il blocco commentato nel Caddyfile)
DESKTOP_DOMAIN=

# --- Notifiche Web Push ---
# Contatto richiesto dallo standard VAPID (un tuo indirizzo o un alias)
VAPID_SUBJECT=mailto:admin@example.com

# --- Fuso orario (controlli automatici alle 8-11 e 17-20) ---
TZ=Europe/Rome

# --- Porta HTTPS di Caddy ---
# Standard: 443 su tutte le interfacce.
# Se condividi la 443 con OpenVPN tramite sslh:  HTTPS_PORT=8443  e  HTTPS_BIND=127.0.0.1
HTTPS_PORT=443
HTTPS_BIND=0.0.0.0

# --- (Opzionale) notifiche anche via ntfy.sh ---
NTFY_ENABLED=0
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
